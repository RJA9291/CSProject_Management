{
  "name": "lfca-video",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render LFCAVideo out/lfca-roadmap.mp4 --codec h264",
    "sheet": "remotion still CharacterSheet public/sprites/host-sheet.png",
    "stills": "node scripts/render-stills.mjs",
    "audio:sfx": "node scripts/generate-audio.mjs",
    "audio:vo": "node scripts/export-script.mjs ep01 && python scripts/generate-voiceover.py --script scripts/script-ep01.json",
    "srt": "node scripts/build-srt.mjs ep01",
    "typecheck": "tsc --noEmit",
    "audio:vo:ep02": "node scripts/export-script.mjs ep02 && python scripts/generate-voiceover.py --script scripts/script-ep02.json --rate +12%",
    "render:ep02": "remotion render CloudVideo out/ep02-cloud-computing.mp4 --codec h264",
    "srt:ep02": "node scripts/build-srt.mjs ep02"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.540",
    "@remotion/cli": "4.0.540",
    "@remotion/google-fonts": "4.0.540",
    "@remotion/media-utils": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "@remotion/transitions": "4.0.540",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3"
  }
}